[Unit]
Description=Deploy dashboard
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/dashboard
Environment=DASHBOARD_CONFIG=/etc/dashboard/config.yaml
ExecStart=/root/.local/bin/uv run --frozen dashboard serve --host 0.0.0.0 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target
