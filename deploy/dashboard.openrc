#!/sbin/openrc-run
# Installed by scripts/install.sh. Set DASHBOARD_HOST / DASHBOARD_PORT in
# /etc/conf.d/dashboard to change where it listens.

name="dashboard"
description="Deploy dashboard"
supervisor="supervise-daemon"
command="/opt/dashboard/.venv/bin/dashboard"
command_args="serve --host ${DASHBOARD_HOST:-0.0.0.0} --port ${DASHBOARD_PORT:-8080}"
directory="/opt/dashboard"
output_log="/var/log/dashboard.log"
error_log="/var/log/dashboard.log"
respawn_delay=5
export DASHBOARD_CONFIG="/etc/dashboard/config.yaml"

depend() {
	need net
}
