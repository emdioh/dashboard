#!/sbin/openrc-run
# Install: cp deploy/dashboard.openrc /etc/init.d/dashboard && rc-update add dashboard

name="dashboard"
description="Deploy dashboard"
supervisor="supervise-daemon"
command="/opt/dashboard/.venv/bin/dashboard"
command_args="serve --host 0.0.0.0 --port 8080"
directory="/opt/dashboard"
output_log="/var/log/dashboard.log"
error_log="/var/log/dashboard.log"
respawn_delay=5
export DASHBOARD_CONFIG="/etc/dashboard/config.yaml"

depend() {
	need net
}
